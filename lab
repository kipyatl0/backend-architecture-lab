#!/usr/bin/env bash
#
# lab — единственная команда стенда. Одна сцена = одна команда: студент не
# пишет `docker compose exec … && curl …` руками, это порог, а не обучение.
#
# Единственная зависимость — Docker. Ни make, ни языковых рантаймов, ни
# установки пакетов. Работает на macOS, Linux и WSL; путь к репозиторию
# значения не имеет.
#
# Договорённость про потоки: в stdout уходит ТОЛЬКО вывод сцены — его
# копируют в текст шага как есть. Всё служебное (что поднимаем, что тянем) —
# в stderr.

set -euo pipefail

LAB_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$LAB_DIR/.lab"
PROJECT="backend-architecture-lab"   # см. `name:` в docker-compose.yml

# Профили Compose, известные стенду. Пополняется вместе с курсом.
KNOWN_PROFILES="mono split net"

# Где живёт модуль уведомлений в каждом профиле. Служба одна и та же — меняется
# только это, и ровно из этого вырастают сцены m03 l05 и весь m05.
notifier_url() {
  case "$1" in
    mono)  printf '' ;;                          # модуль внутри процесса
    split) printf 'http://notifier:8070' ;;      # за сетью
    net)   printf 'http://toxiproxy:8666' ;;     # за сетью, которую можно портить
    *)     printf '' ;;
  esac
}

say()  { printf '%s\n' "$*" >&2; }
die()  { printf 'lab: %s\n' "$*" >&2; exit 2; }

compose() {
  docker compose --project-directory "$LAB_DIR" -f "$LAB_DIR/docker-compose.yml" "$@"
}

# Compose видит сервис — а с ним и его том — только когда включён профиль
# этого сервиса. Поэтому down и reset включают все профили стенда разом:
# иначе `down -v` тихо не удаляет ничего, и reset оставляет старые данные.
compose_all() {
  local args=()
  for p in $KNOWN_PROFILES cli; do args+=(--profile "$p"); done
  compose "${args[@]}" "$@"
}

# Страховка от той же ошибки с другой стороны: что бы ни решил Compose,
# после reset томов проекта остаться не должно.
purge_volumes() {
  local left
  left="$(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null || true)"
  [ -n "$left" ] || return 0
  # shellcheck disable=SC2086
  docker volume rm $left >/dev/null 2>&1 || true
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die "не найден docker — стенду нужен только он"
  docker info >/dev/null 2>&1 || die "docker установлен, но не запущен — запусти Docker и повтори"
}

known_profile() {
  for p in $KNOWN_PROFILES; do
    [ "$p" = "$1" ] && return 0
  done
  die "профиль «$1» не знаком; есть: $KNOWN_PROFILES"
}

current_profile() {
  [ -f "$STATE_DIR/profile" ] && cat "$STATE_DIR/profile" || true
}

remember_profile() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" > "$STATE_DIR/profile"
}

# labctl — исполнитель сцен. Поднимается на время одной команды и исчезает.
labctl() {
  local profile; profile="$(current_profile)"
  LAB_PROFILE="$profile" LAB_NOTIFIER_URL="$(notifier_url "$profile")" \
    compose --profile cli run --rm --no-deps -T labctl "$@"
}

raise() {
  local profile="$1"
  known_profile "$profile"
  say "Поднимаю профиль $profile…"
  # Смена профиля меняет окружение монолита — Compose пересоздаёт контейнер сам.
  LAB_NOTIFIER_URL="$(notifier_url "$profile")" \
    compose --profile "$profile" up -d --wait >&2
  remember_profile "$profile"
}

cmd_up() {
  local profile="${1:-}"
  [ -n "$profile" ] || die "укажи профиль: ./lab up mono"
  raise "$profile"
  say "Готово. Сцены профиля: ./lab scenes"
}

cmd_down() {
  say "Останавливаю стенд (тома остаются)…"
  compose_all down --remove-orphans >&2
}

cmd_reset() {
  local profile="${1:-$(current_profile)}"
  [ -n "$profile" ] || die "укажи профиль: ./lab reset mono"
  say "Сбрасываю состояние: тома пересоздаются…"
  compose_all down -v --remove-orphans >&2
  purge_volumes
  raise "$profile"
  say "Готово: данные в исходном состоянии."
}

cmd_scene() {
  [ $# -gt 0 ] || die "укажи номер сцены: ./lab scene 1"
  local id="$1"; shift
  local profile
  profile="$(labctl profile "$id")"
  raise "$profile"
  labctl scene "$id" "$@"
}

cmd_scenes() { labctl scenes; }
cmd_state()  { labctl state; }

cmd_logs() {
  [ $# -gt 0 ] || die "укажи сервис: ./lab logs monolith"
  compose logs --no-log-prefix "$@"
}

cmd_build() {
  say "Собираю образы стенда локально (запасной путь: обычно они тянутся из GHCR)…"
  local args=()
  for p in $KNOWN_PROFILES; do args+=(--profile "$p"); done
  compose "${args[@]}" --profile cli build >&2
}

cmd_pull() {
  local profile="${1:-$(current_profile)}"
  [ -n "$profile" ] || profile="mono"
  known_profile "$profile"
  compose --profile "$profile" --profile cli pull >&2
}

cmd_help() {
  cat >&2 <<'TXT'
lab — стенд курса «Архитектура бэкенда: распределённые системы и системный дизайн»

  ./lab scene <id>          прогнать сцену и напечатать timeline
  ./lab scene <id> --explain  то же + пояснение, что именно смотреть
  ./lab scenes              список сцен текущего профиля
  ./lab state               текущее состояние данных: заказы, платежи, уведомления

  ./lab up <профиль>        поднять профиль (сцена поднимает свой профиль сама)
  ./lab down                остановить, тома оставить
  ./lab reset [профиль]     вернуть исходное состояние данных, тома пересоздать
  ./lab logs <сервис>       структурированный лог сервиса
  ./lab pull [профиль]      обновить образы
  ./lab build               собрать образы локально (если GHCR недоступен)

Профили:
  mono    служба одним процессом: заказы, оплата, курьеры, уведомления
  split   уведомления вынесены в отдельный сервис — тот же вызов, но по сети
  net     то же самое плюс посредник, которому сцена портит сеть
TXT
}

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift || true
  case "$cmd" in
    up)     require_docker; cmd_up "$@" ;;
    down)   require_docker; cmd_down "$@" ;;
    reset)  require_docker; cmd_reset "$@" ;;
    scene)  require_docker; cmd_scene "$@" ;;
    scenes) require_docker; cmd_scenes "$@" ;;
    state)  require_docker; cmd_state "$@" ;;
    logs)   require_docker; cmd_logs "$@" ;;
    build)  require_docker; cmd_build "$@" ;;
    pull)   require_docker; cmd_pull "$@" ;;
    help|-h|--help) cmd_help ;;
    *)      die "неизвестная команда «$cmd»; ./lab help — список" ;;
  esac
}

main "$@"
